[Unit]
Description=Superwhisper dictation
After=graphical-session.target pipewire.service
PartOf=graphical-session.target
Conflicts=superwhisper-dev.service

[Service]
Type=simple
ExecStart=/usr/bin/superwhisper daemon
ExecStopPost=/usr/bin/superwhisper playback-restore
ExecStopPost=/usr/bin/superwhisper desktop-release
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=15
UMask=0077

[Install]
WantedBy=graphical-session.target
